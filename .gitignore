*.egg
dist/
target/
build/
*.whl
.venv/
venv/
env/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node / Electron ─────────────────────────────────────────────────────────
node_modules/
ui-electron/node_modules/
